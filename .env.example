# ==============================================================================
# SENTINEL - Autonomous Cyber Defense Platform & Automated Cyber Range
# Environment Variables
# ==============================================================================

# General
SENTINEL_ENV=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=sentinel_ultra_secure_secret_key_change_in_production_987654321

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_NETWORK=telemetry-network
KAFKA_TOPIC_ENDPOINT=telemetry-endpoint
KAFKA_TOPIC_AUTH=telemetry-auth
KAFKA_TOPIC_ALERTS=sentinel-alerts
KAFKA_CONSUMER_GROUP=sentinel-core-pipeline

# ClickHouse Configuration
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_DB=sentinel
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=sentinel_clickhouse_password

# Redis / Threat Intel Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# API & WebSocket Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=["*"]

# Automated SOAR Containment
SOAR_AUTO_CONTAINMENT_ENABLED=true
SOAR_DRY_RUN=false
SOAR_MAX_PROCESS_TERMINATIONS_PER_MIN=10
SOAR_FIREWALL_BLOCK_DURATION_SEC=3600

# Anomaly Detection & ML
ANOMALY_CONTAMINATION_RATE=0.01
ANOMALY_BEACONING_JITTER_THRESHOLD=0.15
ATTACK_CHAIN_WINDOW_SECONDS=60
